{
  "name": "warehouse",
  "version": "0.6.0",
  "depends": ["core"],
  "optional_depends": [],
  "provides_api": ["StockService", "LocationService", "LotService"],
  "publishes_events": ["warehouse.stock.reserved", "warehouse.stock.received"],
  "subscribes_events": ["procurement.purchase_order_receipt.confirmed"],
  "migrations_path": "./migrations",
  "permissions": [
    "warehouse.view_moves",
    "warehouse.manage_stock",
    "warehouse.adjust_stock",
    "warehouse.admin_stock",
    "warehouse.admin_locations",
    "warehouse.view_lots",
    "warehouse.manage_lots"
  ]
}
