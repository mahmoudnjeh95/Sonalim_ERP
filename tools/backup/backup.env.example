# Settings for tools/backup/backup.sh and restore.sh.
# On the server: cp backup.env.example backup.env && chmod 600 backup.env, then edit.
# backup.env is not in git and a deploy never overwrites it. Runbook: docs/backups.md.

# Where dumps are kept on the server (created with mode 700). Outside the compose folder,
# so a redeploy or a wrong `rm` in that folder cannot touch them.
BACKUP_DIR=/home/debian/sonalim-erp-backups

# Off-site copy: an rclone remote and folder. Use a `crypt` remote (see the runbook):
# the dumps hold payroll and customer data. Leaving this empty makes every run fail
# with exit 3 (no off-site copy) unless ALLOW_LOCAL_ONLY=1.
BACKUP_REMOTE=offsite-crypt:
#ALLOW_LOCAL_ONLY=0
# rclone config file, if not the default ~/.config/rclone/rclone.conf
#RCLONE_CONFIG=

# Retention: newest dump of each of the last N days / ISO weeks / months that have one.
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12
# Off-site defaults to the same; keep more there if storage allows.
#REMOTE_KEEP_DAILY=14
#REMOTE_KEEP_WEEKLY=8
#REMOTE_KEEP_MONTHLY=24

# Monitors (e.g. https://healthchecks.io, free): alert by email/Telegram when a run
# fails or does not happen. One check for the nightly backup, one for the monthly drill.
#PING_URL=https://hc-ping.com/<uuid>
#DRILL_PING_URL=https://hc-ping.com/<uuid>

# Refuse to dump unless this much space (MB) is free, or twice the last dump if larger.
#MIN_FREE_MB=1024

# Rarely changed:
#DB_NAME=erp
#DB_USER=erp
#COMPOSE_DIR=/home/debian/Sonalim_erp/Erpsonalim
#STOP_SERVICES="web app worker"
# PG_EXEC= (empty) runs local pg_dump/psql with PGHOST/PGPORT/PGPASSWORD instead of
# `docker compose exec -T postgres`.
