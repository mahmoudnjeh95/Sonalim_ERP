{
  "name": "procurement",
  "version": "0.2.0",
  "depends": ["core"],
  "optional_depends": ["warehouse"],
  "provides_api": ["PurchaseOrderService"],
  "publishes_events": ["procurement.purchase_order.status_changed", "procurement.purchase_order_receipt.confirmed"],
  "subscribes_events": ["warehouse.replenishment.approved", "maintenance.parts.purchase_requested"],
  "migrations_path": "./migrations",
  "permissions": [
    "procurement.view_purchase_orders",
    "procurement.manage_purchase_orders",
    "procurement.admin_purchase_orders"
  ]
}
