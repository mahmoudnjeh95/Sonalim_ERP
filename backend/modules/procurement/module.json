{
  "name": "procurement",
  "version": "0.2.0",
  "depends": ["core"],
  "optional_depends": ["warehouse"],
  "provides_api": ["PurchaseOrderService", "PurchaseInvoiceService"],
  "publishes_events": ["procurement.purchase_order.status_changed", "procurement.purchase_order_receipt.confirmed", "procurement.purchase_invoice.validated"],
  "subscribes_events": ["warehouse.replenishment.approved", "maintenance.parts.purchase_requested", "treasury.disbursement.posted", "treasury.disbursement.cancelled", "treasury.instrument.unpaid"],
  "migrations_path": "./migrations",
  "permissions": [
    "procurement.view_purchase_orders",
    "procurement.manage_purchase_orders",
    "procurement.admin_purchase_orders",
    "procurement.view_purchase_invoices",
    "procurement.manage_purchase_invoices",
    "procurement.admin_purchase_invoices"
  ]
}
