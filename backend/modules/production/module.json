{
  "name": "production",
  "version": "0.12.0",
  "depends": ["core"],
  "optional_depends": ["warehouse", "qc", "maintenance", "procurement"],
  "provides_api": [
    "WorkOrderService",
    "ProductClassificationService",
    "PackagingBomService",
    "WorkCenterService",
    "RecipeService",
    "ScrapService",
    "RegrindService",
    "WorkOrderYieldService",
    "ProductionReportService",
    "ConditionnementReportService",
    "OfConsolidationService",
    "RegrindDefaultsService",
    "PackagingVarianceService",
    "PackagingTolerancePolicyService",
    "TeamPerformanceService",
    "MachinePerformanceService",
    "ConsumptionReportService"
  ],
  "publishes_events": [
    "production.work_order.closed",
    "production.report.validated",
    "production.report.rejected"
  ],
  "subscribes_events": ["qc.non_conformity.dispositioned"],
  "migrations_path": "./migrations",
  "permissions": [
    "production.view_work_orders",
    "production.manage_work_orders",
    "production.admin_work_orders",
    "production.suspend_work_orders",
    "production.close_work_orders",
    "production.view_product_classifications",
    "production.manage_product_classifications",
    "production.view_packaging_boms",
    "production.manage_packaging_boms",
    "production.admin_packaging_boms",
    "production.view_work_centers",
    "production.manage_work_centers",
    "production.admin_work_centers",
    "production.view_recipes",
    "production.manage_recipes",
    "production.activate_recipes",
    "production.view_scrap",
    "production.manage_scrap",
    "production.view_regrind",
    "production.manage_regrind",
    "production.assign_regrind",
    "production.view_resource_consumption",
    "production.manage_resource_consumption",
    "production.admin_resource_types",
    "production.view_reports",
    "production.manage_reports",
    "production.validate_reports",
    "production.admin_reports",
    "production.use_ia_assistant"
  ]
}
