{
  "name": "finance",
  "version": "0.2.0",
  "depends": ["core"],
  "optional_depends": ["sales", "warehouse", "payroll", "procurement", "treasury"],
  "provides_api": [
    "InvoiceService",
    "DeliveryBillingService",
    "report_queries",
    "LedgerPostingService",
    "LedgerQueryService",
    "LedgerReportService",
    "PeriodService"
  ],
  "publishes_events": ["finance.invoice.issued", "finance.invoice.paid", "finance.credit_note.issued", "finance.journal_entry.posted"],
  "subscribes_events": [
    "warehouse.voucher.posted",
    "warehouse.shipment.shipped",
    "finance.credit_note.issued",
    "payroll.run.approved",
    "payroll.run.paid",
    "payroll.run.reversed",
    "finance.invoice.issued",
    "finance.invoice.paid",
    "procurement.purchase_invoice.validated",
    "procurement.purchase_invoice.cancelled",
    "procurement.purchase_credit_note.validated",
    "treasury.receipt.posted",
    "treasury.receipt.cancelled",
    "treasury.instrument.unpaid",
    "treasury.disbursement.posted",
    "treasury.disbursement.cancelled",
    "treasury.instrument.collected"
  ],
  "migrations_path": "./migrations",
  "permissions": [
    "finance.view_invoices",
    "finance.manage_invoices",
    "finance.admin_invoices",
    "finance.view_ledger",
    "finance.manage_entries",
    "finance.admin_entries",
    "finance.manage_accounts",
    "finance.admin_accounts",
    "finance.admin_periods",
    "finance.manage_posting_rules"
  ]
}
