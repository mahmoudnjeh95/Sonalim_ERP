{
  "name": "finance",
  "version": "0.1.0",
  "depends": ["core"],
  "optional_depends": ["sales"],
  "provides_api": ["InvoiceService"],
  "publishes_events": ["finance.invoice.issued", "finance.invoice.paid"],
  "subscribes_events": ["sales.order.confirmed", "treasury.receipt.posted", "treasury.receipt.cancelled"],
  "migrations_path": "./migrations",
  "permissions": ["finance.view_invoices", "finance.manage_invoices", "finance.admin_invoices"]
}
