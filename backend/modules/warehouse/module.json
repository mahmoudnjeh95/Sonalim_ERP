{
  "name": "warehouse",
  "version": "0.16.0",
  "depends": ["core"],
  "optional_depends": ["sales", "procurement"],
  "provides_api": [
    "StockService",
    "LocationService",
    "LotService",
    "WarehouseAnalyticsService",
    "SiteService",
    "CycleCountService",
    "PutAwayService",
    "FulfillmentService",
    "BarcodeService",
    "ReservationService",
    "ValuationService",
    "ReplenishmentService"
  ],
  "publishes_events": [
    "warehouse.stock.reserved",
    "warehouse.stock.received",
    "warehouse.stock.issued",
    "warehouse.cycle_count.completed",
    "warehouse.putaway.confirmed",
    "warehouse.pick_list.cancelled",
    "warehouse.shipment.shipped",
    "warehouse.reservation.expired",
    "warehouse.replenishment.approved"
  ],
  "subscribes_events": ["procurement.purchase_order_receipt.confirmed", "core.product.created", "sales.order.confirmed"],
  "migrations_path": "./migrations",
  "permissions": [
    "warehouse.view_moves",
    "warehouse.manage_stock",
    "warehouse.adjust_stock",
    "warehouse.admin_stock",
    "warehouse.admin_locations",
    "warehouse.view_lots",
    "warehouse.manage_lots",
    "warehouse.set_lot_expiry",
    "warehouse.manage_sites",
    "warehouse.admin_sites",
    "warehouse.view_cycle_counts",
    "warehouse.manage_cycle_counts",
    "warehouse.admin_cycle_counts",
    "warehouse.view_putaway",
    "warehouse.manage_putaway",
    "warehouse.view_fulfillment",
    "warehouse.manage_fulfillment",
    "warehouse.admin_shipments",
    "warehouse.manage_barcodes",
    "warehouse.admin_barcodes",
    "warehouse.admin_reservations",
    "warehouse.view_valuation",
    "warehouse.view_replenishment",
    "warehouse.manage_replenishment",
    "warehouse.admin_reorder_rules"
  ]
}
