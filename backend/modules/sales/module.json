{
  "name": "sales",
  "version": "0.3.0",
  "depends": ["core", "warehouse"],
  "optional_depends": ["finance"],
  "provides_api": ["SalesOrderService", "PricingService", "QuoteService"],
  "publishes_events": ["sales.order.confirmed"],
  "subscribes_events": ["warehouse.shipment.shipped", "warehouse.voucher.posted"],
  "migrations_path": "./migrations",
  "permissions": [
    "sales.view_orders",
    "sales.manage_orders",
    "sales.admin_orders",
    "sales.view_quotes",
    "sales.manage_quotes",
    "sales.manage_price_lists",
    "sales.admin_discounts"
  ]
}
