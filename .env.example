# Copy to .env (repo root) and adjust as needed before running `docker compose up`.
# All variables are optional — every one has a working default for local use.

# --- Secrets (change for anything beyond local use) ---
POSTGRES_PASSWORD=erp
RABBITMQ_PASSWORD=erp

# --- Optional integrations ---
GROQ_API_KEY=

# --- Frontend build/runtime ---
# Host port for the web container. Set to 80 when no other service uses it.
WEB_PORT=8080
# Base URL the browser uses to reach the API (baked into the frontend build).
# The default uses the web container's /api reverse proxy.
VITE_API_BASE_URL=/api
# Origins the API accepts CORS requests from (comma-separated). Must include
# wherever the frontend container is actually served from.
FRONTEND_ORIGINS=http://localhost

# --- Database migrations ---
# On by default: app and worker apply pending schema migrations at startup (one at a
# time, under a Postgres advisory lock). Migrations never contain test/demo data.
# Set to false to only log pending ones and apply `python -m scripts.migration_sql` by hand.
AUTO_MIGRATE=true

# --- Advanced: only set these if you need to point at infra outside compose ---
# DATABASE_URL=postgresql://erp:${POSTGRES_PASSWORD}@postgres:5432/erp
# REDIS_URL=redis://redis:6379/0
# RABBITMQ_URL=amqp://erp:${RABBITMQ_PASSWORD}@rabbitmq:5672/
